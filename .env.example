# PFスクラップ管理 環境変数（他のPFシリーズと同一パターン）

# ===== データベース（Supabase Postgres）=====
# Supabase → Project → Connect →「Session pooler」の接続文字列を使う。
# 例) postgresql://postgres.<project-ref>:<password>@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres?sslmode=require
# ※ Vercel のサーバーレスからは直接接続(db.<ref>.supabase.co)ではなく必ずプーラ経由にする。
DATABASE_URL=

# ドライバ指定。Supabase では pg を明示する（未指定でもホスト名から自動判定して pg になる）。
DB_DRIVER=pg

# ===== next-auth =====
# openssl rand -base64 32 などで生成
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:5188

# ===== ポータル連携 =====
# SSO / 一括ログアウト / アカウント一括発行 / 工場マスタ配信 の共有キー。
# pf-portal と同じ値を設定する（一致しないと連携がすべて弾かれる）
PF_PROVISION_KEY=

# 統一管理者（login_id='admin'）ブートストラップ用の bcrypt ハッシュ（任意・SSO障害時の復旧用）
PF_ADMIN_BOOTSTRAP_HASH=

# 社内運用（課金ゲートなし）にする場合は 1
ON_PREMISE=1
