# PFスクラップ管理 環境変数（他のPFシリーズと同一パターン）

# Neon Postgres（スクラップ専用DB）。オンプレは通常の Postgres URL + DB_DRIVER=pg でも可
DATABASE_URL=

# next-auth
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:5188

# ポータル連携の共有キー（SSO / 一括ログアウト / アカウント一括発行 / マスタ配信）。
# pf-portal と同じ値を設定する
PF_PROVISION_KEY=

# 統一管理者（login_id='admin'）ブートストラップ用の bcrypt ハッシュ（任意）
PF_ADMIN_BOOTSTRAP_HASH=

# 社内運用（課金ゲートなし）にする場合は 1
ON_PREMISE=1
